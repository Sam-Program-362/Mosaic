        android:fillColor="#FF4500"
        android:pathData="M34,34h18v18h-18z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M56,34h18v18h-18z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,56h18v18h-18z" />
    <path
        android:fillColor="#FF4500"
        android:pathData="M56,56h18v18h-18z" />
